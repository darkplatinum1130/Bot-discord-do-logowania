# Token bota z https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# ID Twojego serwera – komendy pojawią się od razu tylko tam.
# Zostaw puste, żeby komendy były globalne (działają też w DM z botem, ale pojawiają się po kilku minutach).
GUILD_ID=

# Adres i port API, z którym łączą się aplikacje
API_HOST=0.0.0.0
API_PORT=8080
# Publiczny adres API (tylko do wyświetlania w /aplikacja info)
PUBLIC_URL=http://localhost:8080

# true, jeśli API stoi za nginx / Cloudflare (IP z nagłówka X-Forwarded-For)
TRUST_PROXY=false
# Dozwolone originy dla aplikacji webowych (oddzielone przecinkami) albo *
CORS_ORIGINS=*

DATABASE_PATH=data.db
# Ważność kodów logowania w sekundach
CODE_TTL=300
# Jak długo cache'ować role użytkownika przy sprawdzaniu tokenu (sekundy)
MEMBER_CACHE_TTL=60
